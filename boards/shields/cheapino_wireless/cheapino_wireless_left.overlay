/ {
    chosen {
        zmk,kscan = &mock_kscan_left;
    };

    /* Temporary mock kscan to verify BLE boot — replace with real charlieplex once pins are confirmed */
    mock_kscan_left: mock_kscan_left {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
