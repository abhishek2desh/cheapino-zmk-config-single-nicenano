#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_left;
        zmk,matrix-transform = &left_transform;
    };

    left_transform: keymap_transform_left {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <6>;
        map = <
            RC(0,5) RC(4,0) RC(0,4) RC(3,0) RC(0,3)   /* top row    pos 0–4  */
            RC(1,5) RC(4,1) RC(1,4) RC(3,1) RC(1,3)   /* middle row pos 5–9  */
            RC(2,5) RC(4,2) RC(2,4) RC(3,2) RC(2,3)   /* bottom row pos 10–14 */
                            RC(5,2) RC(5,1) RC(5,0)   /* thumbs     pos 15–17 */
        >;
    };

    kscan_left: kscan_left {
        compatible = "zmk,kscan-gpio-charlieplex";
        gpios
            = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 0: (GP29, P1.11) — testing swap */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 1: middle row (GP28, P1.13) */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 2: (GP27, P1.15) — testing swap */
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 3: rightmost col (GP14, P0.31) */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 4: middle col    (GP15, P0.29) */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Pin 5: leftmost + thumb col (GP26, P0.02) */
            ;
    };
};
