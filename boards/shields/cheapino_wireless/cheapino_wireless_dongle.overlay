#include <dt-bindings/zmk/matrix_transform.h>
#include "../cheapinov2/cheapinov2-layout.dtsi"

&cheapino_layout {
    transform = <&dongle_transform>;
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &cheapino_layout;
    };

    dongle_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <12>;
        map = <
            /* left half — positions 0–17 */
            RC(0,5) RC(4,0) RC(0,4) RC(3,0) RC(0,3)   /* top row    pos 0–4  */
            RC(1,5) RC(4,1) RC(1,4) RC(3,1) RC(1,3)   /* middle row pos 5–9  */
            RC(2,5) RC(4,2) RC(2,4) RC(3,2) RC(2,3)   /* bottom row pos 10–14 */
                            RC(5,2) RC(5,1) RC(5,0)   /* thumbs     pos 15–17 */
            /* right half — positions 18–35 */
            RC(6,9)  RC(9,6)  RC(6,10)  RC(10,6)  RC(6,11)   /* top row    pos 18–22 */
            RC(7,9)  RC(9,7)  RC(7,10)  RC(10,7)  RC(7,11)   /* middle row pos 23–27 */
            RC(8,9)  RC(9,8)  RC(8,10)  RC(10,8)  RC(8,11)   /* bottom row pos 28–32 */
                              RC(11,6) RC(11,7) RC(11,8)      /* thumbs     pos 33–35 */
        >;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};
