#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan_right;
        zmk,matrix-transform = &right_transform;
    };

    right_transform: keymap_transform_right {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <6>;
        /* RC indices are wired RC(6..11, 6..11) remapped to RC(0..5, 0..5) */
        map = <
            RC(0,3) RC(3,0) RC(0,4) RC(4,0) RC(0,5)   /* top row    pos 0–4  */
            RC(1,3) RC(3,1) RC(1,4) RC(4,1) RC(1,5)   /* middle row pos 5–9  */
            RC(2,3) RC(3,2) RC(2,4) RC(4,2) RC(2,5)   /* bottom row pos 10–14 */
                            RC(5,0) RC(5,1) RC(5,2)   /* thumbs     pos 15–17 */
        >;
    };

    /* TODO: GPIO pins are placeholders — verify right-half MCU pinout from schematic */
    kscan_right: kscan_right {
        compatible = "zmk,kscan-gpio-charlieplex";
        gpios
            = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
