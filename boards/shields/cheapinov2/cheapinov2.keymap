//     ___ _                      _
//    / __\ |___  ___  __ _ _ __ (_)_ ___  ____
//   / /  | '_  \/ _ \/ _` | '_ \| | '_  \/ _  \
//  / /___| | | |  __/ (_| | |_) | | | | | (_) |
//  \____/|_| |_|\___|\__,_| .__/|_|_| |_|\___/
//                         |_|
//
// Binding order: all left keys first (pos 0–17), then all right keys (pos 18–35).
// Positions per row: left top(0–4) mid(5–9) bot(10–14) thumbs(15–17)
//                    right top(18–22) mid(23–27) bot(28–32) thumbs(33–35)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define MEDIA  1
#define NAV  2
#define MOUSE  3
#define SYMBOL  4
#define FUNCTION  5
#define NUMPAD  6

&mt {
  quick-tap-ms = <150>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <150>;
  require-prior-idle-ms = <150>;
  hold-trigger-on-release;
};

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE>;
};

/ {
        keymap {
                compatible = "zmk,keymap";
        BASE {
          bindings = <
          /* left: top row */
          &kp Q &kp W &kp E &kp R &kp T
          /* left: middle row */
          &mt LEFT_GUI A &mt LEFT_ALT S &mt LEFT_CONTROL D &mt LEFT_SHIFT F &kp G
          /* left: bottom row */
          &kp Z &kp X &kp C &kp V &kp B
          /* left: thumbs */
          &lt 1 ESC &lt 2 SPACE &lt 3 TAB
          /* right: top row */
          &kp Y &kp U &kp I &kp O &kp P
          /* right: middle row */
          &kp H &mt LEFT_SHIFT J &mt LEFT_CONTROL K &mt LEFT_ALT L &mt LEFT_GUI SEMICOLON
          /* right: bottom row */
          &kp N &kp M &kp COMMA &kp DOT &kp SLASH
          /* right: thumbs */
          &lt 4 ENTER &lt 6 BACKSPACE &lt 5 DELETE
          >;
        };
        MEDIA {
          bindings = <
          /* left: top row */
          &kp C_VOLUME_UP &none &none &none &none
          /* left: middle row */
          &none &none &none &none &kp C_MUTE
          /* left: bottom row */
          &kp C_VOLUME_DOWN &kp C_NEXT &none &none &kp C_PLAY_PAUSE
          /* left: thumbs */
          &none &trans &trans
          /* right: top row */
          &bt BT_CLR_ALL &bt BT_PRV &bt BT_NXT &kp C_POWER &none
          /* right: middle row */
          &none &trans &trans &trans &trans
          /* right: bottom row */
          &none &none &none &none &none
          /* right: thumbs */
          &none &none &none
          >;
        };
        NAV {
          bindings = <
          /* left: top row */
          &none &none &none &none &none
          /* left: middle row */
          &none &none &none &none &none
          /* left: bottom row */
          &none &none &none &none &none
          /* left: thumbs */
          &trans &none &trans
          /* right: top row */
          &none &none &none &none &none
          /* right: middle row */
          &kp LEFT &kp DOWN &kp UP &kp RIGHT &caps_word
          /* right: bottom row */
          &kp HOME &kp PG_DN &kp PG_UP &kp END &kp INS
          /* right: thumbs */
          &trans &trans &trans
          >;
        };
        MOUSE {
          bindings = <
          /* left: top row */
          &none &none &none &none &none
          /* left: middle row */
          &trans &trans &trans &none &none
          /* left: bottom row */
          &mkp MB4 &mkp MB3 &mkp MB2 &mkp MB1 &none
          /* left: thumbs */
          &trans &trans &trans
          /* right: top row */
          &kp AT &kp UNDERSCORE &kp PIPE &kp GRAVE &kp PERCENT
          /* right: middle row */
          &kp HASH &kp TAB &kp EXCLAMATION &kp DOUBLE_QUOTES &kp DOLLAR
          /* right: bottom row */
          &kp TILDE2 &kp SINGLE_QUOTE &kp BACKSLASH &kp SLASH &kp AMPERSAND
          /* right: thumbs */
          &trans &trans &trans
          >;
        };
        SYMBOL {
          bindings = <
          /* left: top row */
          &kp LEFT_BRACE &kp AMPERSAND &kp ASTERISK &kp LEFT_PARENTHESIS &kp RIGHT_BRACE
          /* left: middle row */
          &kp DOUBLE_QUOTES &kp DOLLAR &kp PERCENT &kp CARET &kp PLUS
          /* left: bottom row */
          &kp TILDE &kp EXCL &kp AT &kp HASH &kp PIPE
          /* left: thumbs */
          &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp UNDERSCORE
          /* right: top row */
          &none &none &none &none &none
          /* right: middle row */
          &none &trans &trans &trans &trans
          /* right: bottom row */
          &none &none &none &none &none
          /* right: thumbs */
          &none &trans &trans
          >;
        };
        FUNCTION {
          bindings = <
          /* left: top row */
          &kp C_POWER &none &none &none &none
          /* left: middle row */
          &trans &trans &trans &trans &none
          /* left: bottom row */
          &none &none &none &none &none
          /* left: thumbs */
          &trans &trans &trans
          /* right: top row */
          &none &kp F7 &kp F8 &kp F9 &kp F10
          /* right: middle row */
          &none &kp F4 &kp F5 &kp F6 &kp F11
          /* right: bottom row */
          &none &kp F1 &kp F2 &kp F3 &kp F12
          /* right: thumbs */
          &trans &trans &trans
          >;
        };
        NUMPAD {
          bindings = <
          /* left: top row */
          &kp LEFT_BRACKET &kp N7 &kp N8 &kp N9 &kp RIGHT_BRACKET
          /* left: middle row */
          &kp SINGLE_QUOTE &kp N4 &kp N5 &kp N6 &kp EQUAL
          /* left: bottom row */
          &kp GRAVE &kp N1 &kp N2 &kp N3 &kp BACKSLASH
          /* left: thumbs */
          &kp DOT &kp N0 &kp MINUS
          /* right: top row */
          &none &none &none &none &none
          /* right: middle row */
          &none &kp LEFT_SHIFT &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI
          /* right: bottom row */
          &none &none &none &none &none
          /* right: thumbs */
          &none &none &none
          >;
        };
    };
};
